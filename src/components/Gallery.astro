---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { Locale } from '@/config/site'
import { useTranslations } from '@/i18n/ui'

type Shot = { src: ImageMetadata; alt: string }

interface Props {
  locale: Locale
  images: Shot[]
  video?: string
  poster?: ImageMetadata
}

const { locale, images, video, poster } = Astro.props
const t = useTranslations(locale)

/** The video, when there is one, closes the gallery — stills first, motion last. */
const slides = [
  ...images.map((image, index) => ({ kind: 'image' as const, image, index })),
  ...(video ? [{ kind: 'video' as const, index: images.length }] : []),
]
const total = slides.length
---

{total > 0 && (
  <figure class="gal" data-gallery>
    <div class="gal__stage">
      {slides.map((slide) =>
        slide.kind === 'image' ? (
          <div class="gal__slide" data-slide={slide.index} data-active={slide.index === 0 ? '' : undefined}>
            <Image
              src={slide.image.src}
              alt={slide.image.alt}
              widths={[760, 1400, 2000]}
              sizes="(min-width: 1100px) 1100px, 94vw"
              loading={slide.index === 0 ? 'eager' : 'lazy'}
            />
          </div>
        ) : (
          <div class="gal__slide gal__slide--video" data-slide={slide.index}>
            <video controls muted playsinline preload="none" poster={poster?.src} width="1280" height="720">
              <source src={video} type="video/mp4" />
            </video>
          </div>
        ),
      )}

      {total > 1 && (
        <>
          <button class="gal__nav gal__nav--prev" type="button" data-prev aria-label={t('gallery.prev')}>
            <span aria-hidden="true">←</span>
          </button>
          <button class="gal__nav gal__nav--next" type="button" data-next aria-label={t('gallery.next')}>
            <span aria-hidden="true">→</span>
          </button>
        </>
      )}
    </div>

    {total > 1 && (
      <div class="gal__thumbs" role="tablist">
        {slides.map((slide) => (
          <button
            class="gal__thumb"
            type="button"
            role="tab"
            data-thumb={slide.index}
            data-active={slide.index === 0 ? '' : undefined}
            aria-selected={slide.index === 0 ? 'true' : 'false'}
          >
            {slide.kind === 'image' ? (
              <Image src={slide.image.src} alt="" widths={[200]} sizes="120px" loading="lazy" />
            ) : (
              <span class="gal__thumb-video">
                {poster && <Image src={poster} alt="" widths={[200]} sizes="120px" loading="lazy" />}
                <span class="gal__play" aria-hidden="true">▶</span>
                <span class="sr">{t('gallery.video')}</span>
              </span>
            )}
          </button>
        ))}
      </div>
    )}

    {total > 1 && (
      <figcaption class="gal__caption">
        <span class="gal__count">
          <b data-current>1</b> {t('gallery.counter')} {total}
        </span>
      </figcaption>
    )}
  </figure>
)}

<style>
  .gal { margin: 0 0 clamp(2rem, 5vw, 3rem); }

  .gal__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-sunken);
  }

  .gal__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .gal__slide[data-active] {
    opacity: 1;
    visibility: visible;
  }
  .gal__slide :global(img),
  .gal__slide video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gal__slide--video { background: #000; }
  .gal__slide--video video { object-fit: contain; }

  .gal__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-raised) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--color-ink);
    font-size: 0.95rem;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast);
  }
  .gal__nav:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .gal__nav--prev { left: 0.75rem; }
  .gal__nav--next { right: 0.75rem; }

  .gal__caption {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }
  .gal__count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .gal__count b { color: var(--color-accent); font-weight: 500; }

  .gal__thumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.875rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }
  .gal__thumb {
    position: relative;
    flex: none;
    width: 7.5rem;
    aspect-ratio: 16 / 10;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    border-radius: 7px;
    border: 1px solid var(--color-line);
    background: var(--color-sunken);
    opacity: 0.55;
    transition: opacity var(--dur-fast), border-color var(--dur-fast) var(--ease-out);
  }
  .gal__thumb:hover { opacity: 0.85; }
  .gal__thumb[data-active] {
    opacity: 1;
    border-color: var(--color-accent);
  }
  .gal__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gal__thumb-video { display: block; width: 100%; height: 100%; }
  .gal__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgb(0 0 0 / 0.35);
    font-size: 0.8rem;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__slide { transition: none; }
  }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]')

  if (gallery) {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-slide]'))
    const thumbs = Array.from(gallery.querySelectorAll<HTMLElement>('[data-thumb]'))
    const current = gallery.querySelector<HTMLElement>('[data-current]')
    let index = 0

    const show = (next: number) => {
      index = (next + slides.length) % slides.length

      for (const [i, slide] of slides.entries()) {
        slide.toggleAttribute('data-active', i === index)
        // Never leave a video playing on a slide nobody can see.
        if (i !== index) slide.querySelector('video')?.pause()
      }

      for (const [i, thumb] of thumbs.entries()) {
        thumb.toggleAttribute('data-active', i === index)
        thumb.setAttribute('aria-selected', String(i === index))
      }

      if (current) current.textContent = String(index + 1)
    }

    gallery.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1))
    gallery.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1))
    for (const [i, thumb] of thumbs.entries()) {
      thumb.addEventListener('click', () => show(i))
    }

    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1)
      if (event.key === 'ArrowRight') show(index + 1)
    })
  }
</script>
