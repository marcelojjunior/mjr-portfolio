---
import { Image } from 'astro:assets'
import type { Locale } from '@/config/site'
import { projectPath } from '@/lib/i18n'
import { useTranslations } from '@/i18n/ui'
import type { CaseEntry } from '@/lib/projects'
import { slugOf } from '@/lib/projects'

interface Props {
  entry: CaseEntry
  locale: Locale
}

const { entry, locale } = Astro.props
const t = useTranslations(locale)
const slug = slugOf(entry)
const { title, summary, tags, cover, images } = entry.data

/**
 * Resting frame first, then up to three more that crossfade while the pointer is on the card.
 * De-duplicated, because `cover` is usually also the first gallery image.
 * With no artwork yet, the placeholder blocks stand in.
 */
const frames = [...new Map(
  [cover, ...images.map((image) => image.src)]
    .filter((src): src is NonNullable<typeof cover> => Boolean(src))
    .map((src) => [src.src, src]),
).values()].slice(0, 4)
const href = projectPath(locale, slug)
---

<a class="card" href={href} data-cursor-grow>
  <div class="card__media">
    <span class="card__badge">{t('work.badge')}</span>

    {frames.length > 0 ? (
      <div class="shots">
        {frames.map((src, index) => (
          <Image
            src={src}
            alt=""
            widths={[480, 800]}
            sizes="(min-width: 760px) 45vw, 92vw"
            loading="lazy"
            class={index === 0 ? 'shot shot--first' : 'shot'}
          />
        ))}
      </div>
    ) : (
      <div class="frames" aria-hidden="true">
        <span class="frame frame--1"></span>
        <span class="frame frame--2"></span>
        <span class="frame frame--3"></span>
      </div>
    )}
  </div>

  <h3 class="card__title">{title}</h3>
  <p class="card__desc">{summary}</p>

  <div class="card__tags">
    {tags.map((tag) => <span>{tag}</span>)}
  </div>

  <span class="card__go">{t('work.open')} <i aria-hidden="true">→</i></span>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    padding: 0.75rem 0.75rem 1.25rem;
    overflow: hidden;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: var(--color-accent);
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-sunken);
  }
  .shots { position: absolute; inset: 0; }
  .card__media :global(.shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    opacity: 0;
  }
  .card__media :global(.shot--first) { opacity: 1; }

  /* Cycle only while hovered; at rest the card shows a single, stable frame. */
  .card:hover .card__media :global(.shot) {
    animation: shot-cycle 5.2s var(--ease-out) infinite;
  }
  .card:hover .card__media :global(.shot:nth-child(2)) { animation-delay: 1.3s; }
  .card:hover .card__media :global(.shot:nth-child(3)) { animation-delay: 2.6s; }
  .card:hover .card__media :global(.shot:nth-child(4)) { animation-delay: 3.9s; }

  @keyframes shot-cycle {
    0%, 20% { opacity: 1; }
    26%, 94% { opacity: 0; }
    100% { opacity: 1; }
  }

  .card__badge {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity var(--dur-fast), transform var(--dur-fast) var(--ease-out);
  }
  .card:hover .card__badge {
    opacity: 1;
    transform: translateY(0);
  }

  /* Placeholder preview: three blocks crossfading on hover, until real screenshots land. */
  .frames {
    position: absolute;
    inset: 0;
  }
  .frame {
    position: absolute;
    inset: 12%;
    border-radius: 4px;
    background: var(--color-line);
    opacity: 0;
  }
  .frame--1 {
    opacity: 1;
    inset: 12% 12% 42% 12%;
  }
  .frame--2 {
    inset: 42% 12% 12% 46%;
    background: var(--color-accent);
  }
  .frame--3 {
    inset: 42% 58% 12% 12%;
  }
  .card:hover .frame {
    animation: cycle 2.7s var(--ease-out) infinite;
  }
  .card:hover .frame--2 { animation-delay: 0.9s; }
  .card:hover .frame--3 { animation-delay: 1.8s; }
  @keyframes cycle {
    0%, 28% { opacity: 1; }
    34%, 94% { opacity: 0; }
    100% { opacity: 1; }
  }

  .card__title {
    font-size: 1.5rem;
    margin-top: 1rem;
  }
  .card__desc {
    color: var(--color-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0.5rem 0 0;
    max-width: 46ch;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.875rem;
  }
  .card__tags span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    color: var(--color-dim);
    opacity: 0.6;
    transform: translateY(6px);
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base),
      border-color var(--dur-fast),
      color var(--dur-fast);
  }
  .card:hover .card__tags span {
    opacity: 1;
    transform: translateY(0);
    border-color: var(--color-accent);
    color: var(--color-ink);
  }
  .card:hover .card__tags span:nth-child(2) { transition-delay: 0.04s; }
  .card:hover .card__tags span:nth-child(3) { transition-delay: 0.08s; }
  .card:hover .card__tags span:nth-child(4) { transition-delay: 0.12s; }
  .card:hover .card__tags span:nth-child(5) { transition-delay: 0.16s; }

  .card__go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .card__go i {
    font-style: normal;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .card:hover .card__go i { transform: translateX(5px); }

  @media (prefers-reduced-motion: reduce) {
    .card:hover { transform: none; }
    .card__tags span { opacity: 1; transform: none; }
    .card:hover .frame,
    .card:hover .card__media :global(.shot) { animation: none; }
  }
</style>
