---
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import type { Locale } from '@/config/site'
import { useTranslations } from '@/i18n/ui'
import { projectsPath } from '@/lib/i18n'
import type { CaseEntry } from '@/lib/projects'
import Gallery from '@/components/Gallery.astro'

interface Props {
  entry: CaseEntry
  locale: Locale
}

const { entry, locale } = Astro.props
const t = useTranslations(locale)
const { Content } = await render(entry)
const { title, period, kind, stack, images, outcomes, links, summary, video, cover, company, role } = entry.data
const hasPlaceholder = outcomes.some((o) => o.placeholder)
---

<article class="case wrap">
  <a class="case__back" href={projectsPath(locale)}>← {t('case.back')}</a>

  <header class="case__head">
    <p class="eyebrow">{kind}</p>
    <h1>{title}</h1>
    <p class="case__summary">{summary}</p>
  </header>

  <div class="case__grid">
    <div class="case__main">
      <Gallery locale={locale} images={images} video={video} poster={cover} />

      <div class="prose">
        <Content />
      </div>

      {outcomes.length > 0 && (
        <section class="outcome">
          <p class="eyebrow">{t('case.outcome')}</p>
          <ul>
            {outcomes.map((o) => (
              <li>
                <b>{o.value}</b>
                <span>{o.label}</span>
              </li>
            ))}
          </ul>
          {hasPlaceholder && <p class="outcome__note">{t('case.placeholderNote')}</p>}
        </section>
      )}
    </div>

    <aside class="sidecar">
      {company && (
        <>
          <div>
            <h2>{t('case.company')}</h2>
            <p><a href={company.url} rel="noopener" target="_blank">{company.name} ↗</a></p>
          </div>
          <div>
            <h2>{t('case.role')}</h2>
            <p>{role}</p>
          </div>
        </>
      )}
      <div>
        <h2>{t('case.period')}</h2>
        <p>{period}</p>
      </div>
      <div>
        <h2>{t('case.stack')}</h2>
        <div class="chips">
          {stack.map((item) => <span>{item}</span>)}
        </div>
      </div>
      <div>
        <h2>{t('case.links')}</h2>
        {links.case && company && <p><a href={links.case} rel="noopener" target="_blank">{t('case.companyCase')} {company.name} ↗</a></p>}
        {links.live && <p><a href={links.live} rel="noopener" target="_blank">{t('case.live')} ↗</a></p>}
        {links.repo && <p><a href={links.repo} rel="noopener" target="_blank">{t('case.repo')} ↗</a></p>}
        {!links.live && !links.repo && !links.case && <p class="muted">{t('case.repoPrivate')}</p>}
      </div>
    </aside>
  </div>
</article>

<style>
  .wrap {
    max-width: var(--content-width);
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter) 0;
  }

  .case__back {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-dim);
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .case__back:hover { color: var(--color-accent); }

  .case__head { margin-top: 2rem; }
  .case__head h1 {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    margin-top: 0.6rem;
  }
  .case__summary {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    color: var(--color-dim);
    max-width: 52ch;
    margin: 1rem 0 0;
  }

  .case__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  /* Grid items default to min-width:auto, so the gallery's intrinsic media width
     was pushing the whole column past the viewport on narrow screens. */
  .case__grid > * {
    min-width: 0;
  }

  /* Below the two-column breakpoint the facts come first: someone scanning on a phone
     should see role, stack and the live link before scrolling through the gallery. */
  .case__main { order: 2; }
  .sidecar { order: 1; }
  @media (min-width: 900px) {
    .case__grid { grid-template-columns: minmax(0, 1fr) 15rem; }
    .case__main { order: 0; }
    .sidecar { order: 0; }
  }

  .prose { max-width: 66ch; line-height: 1.7; }
  .prose :global(p) { margin: 0 0 1.15em; }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .prose :global(a:hover) { text-decoration-thickness: 2px; }
  .prose :global(h2) {
    font-size: 1.75rem;
    margin: 3rem 0 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .prose :global(h3) {
    font-size: 1.2rem;
    margin: 2rem 0 0.6rem;
    color: var(--color-accent);
  }
  .prose :global(blockquote) {
    margin: 1.25rem 0;
    padding-left: 0.95rem;
    border-left: 2px solid var(--color-accent);
    color: var(--color-dim);
    font-size: 0.96rem;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--color-accent-soft);
    padding: 0.12em 0.35em;
    border-radius: 3px;
  }

  .outcome {
    margin-top: 2.75rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
  }
  .outcome ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .outcome li {
    display: flex;
    gap: 0.875rem;
    align-items: baseline;
    line-height: 1.5;
  }
  .outcome b {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    min-width: 4.5ch;
  }
  .outcome__note {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-dim);
    margin-top: 1.25rem;
  }

  .sidecar {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 12px;
    background: var(--color-raised);
  }
  @media (min-width: 560px) and (max-width: 899px) {
    .sidecar { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 900px) {
    .sidecar {
      grid-template-columns: minmax(0, 1fr);
      padding: 0;
      border: 0;
      background: none;
      position: sticky;
      top: 6rem;
      /* Grid items stretch by default, leaving sticky nothing to travel within. */
      align-self: start;
    }
  }
  .sidecar h2 {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin-bottom: 0.4rem;
  }
  .sidecar p { margin: 0; font-size: 0.92rem; }
  .sidecar a { color: var(--color-accent); text-decoration: none; }
  .sidecar a:hover { text-decoration: underline; }
  .sidecar .muted { color: var(--color-dim); }

  .chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
  .chips span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-accent-soft);
    border-radius: 3px;
  }
</style>
