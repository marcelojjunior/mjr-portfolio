---
import { getEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import AboutView from '@/components/AboutView.astro'
import { personSchema } from '@/lib/jsonld'

const locale = 'en' as const
const entry = await getEntry('pages', 'en/about')
if (!entry) throw new Error('Missing content: src/content/pages/en/about.mdx')
---

<BaseLayout
  locale={locale}
  page={{ kind: 'about' }}
  title="About — Marcelo Junior"
  description={entry.data.description}
  jsonLd={[personSchema(locale)]}
>
  <AboutView entry={entry} locale={locale} />
</BaseLayout>
