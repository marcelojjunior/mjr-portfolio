---
import { getEntry } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import AboutView from '@/components/AboutView.astro'
import { personSchema } from '@/lib/jsonld'

const locale = 'pt' as const
const entry = await getEntry('pages', 'pt/about')
if (!entry) throw new Error('Missing content: src/content/pages/pt/about.mdx')
---

<BaseLayout
  locale={locale}
  page={{ kind: 'about' }}
  title="Sobre — Marcelo Junior"
  description={entry.data.description}
  jsonLd={[personSchema(locale)]}
>
  <AboutView entry={entry} locale={locale} />
</BaseLayout>
