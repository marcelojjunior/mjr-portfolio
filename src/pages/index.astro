---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HomeView from '@/components/HomeView.astro'
import { personSchema, websiteSchema } from '@/lib/jsonld'
import { assertLocaleParity } from '@/lib/projects'

await assertLocaleParity()

const locale = 'pt' as const
---

<BaseLayout
  locale={locale}
  page={{ kind: 'home' }}
  title="Marcelo Junior — Engenheiro de Software"
  description="Engenheiro de software full stack em São Paulo. Construo APIs e interfaces que aguentam uso real, com Laravel, React, Next.js e React Native."
  jsonLd={[personSchema(locale), websiteSchema(locale)]}
>
  <HomeView locale={locale} />
</BaseLayout>
